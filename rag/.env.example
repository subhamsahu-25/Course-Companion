PORT=3000

# Same Mongo cluster/database the main backend uses — the review queue is
# persisted here now instead of an in-memory Map, so it survives restarts.
MONGODB_URI=mongodb+srv://theZeus:vymxKV0691U96NTK@cluster0.2q9ihz3.mongodb.net

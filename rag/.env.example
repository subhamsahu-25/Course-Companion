# Cloud Run injects PORT; the rag server already listens on process.env.PORT.
PORT=3000

# Same cluster/DB the backend uses — the review queue lives there.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>
DB_NAME=course_companion

# Must match backend's RAG_SERVICE_KEY exactly.
RAG_SERVICE_KEY=<generate-a-long-random-string>

# Google AI Studio key (LLM + embeddings).
GEMINI_API_KEY=<your-gemini-key>

# Model selection (all optional — defaults shown). The light model backs
# follow-ups, overviews, and figure captions; 3.6-flash free tier is
# ~20 req/day, so quota-constrained testing should use flash-lite.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite

# Qdrant Cloud free cluster (https://cloud.qdrant.io → Create → Free).
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION=course_collection

# key are rejected. Generate any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAG_SERVICE_KEY=74864ede5349b3351bbc0adbf9dbbc08a671c1ff48a5afc6d34aa4cebb3d09da

# Local Ollama instance used for embeddings + generation.
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB vector store populated by `npm run` on ingest.js.
CHROMA_URL=http://localhost:8000

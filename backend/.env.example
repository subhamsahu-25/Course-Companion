# Copy to .env and fill in real values. NEVER commit .env.
# Database (shared with the rag service)
MONGODB_URI=
DB_NAME=
# Server
PORT=8888
NODE_ENV=development
# CORS: comma-separated allowed origins (deployed frontend first locally)
CORS_ORIGIN=
FRONTEND_URL=
# Auth JWTs (generate long random strings; rotating logs everyone out)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d
# RAG service link (must match rag/.env RAG_SERVICE_KEY)
RAG_SERVICE_KEY=
RAG_SERVICE_URL=
# Legacy local ingest path (unused when uploads go through the API)
RAG_COURSE_MATERIALS_PATH=
# Mail: Brevo preferred (Railway blocks SMTP ports); Mailtrap = sandbox
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# Cloudinary durable file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# BYOK vault: 64 hex chars (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GEMINI_KEY_SECRET=
# Cross-site cookies: local as below; production needs none=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

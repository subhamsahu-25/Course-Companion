PORT=8000
NODE_ENV=development

# MongoDB — same values must be used in rag/.env, since the rag service
# stores its review queue in this same database.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=course-companion

# Comma-separated list of allowed frontend origins for CORS.
# Also used as the link in outgoing emails (the first origin in the list).
CORS_ORIGIN=http://localhost:5173

# JWT secrets — use long random strings, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# Shared secret sent to the rag microservice on every request.
# Must match RAG_SERVICE_KEY in rag/.env exactly.
RAG_SERVICE_URL=http://localhost:3000
RAG_SERVICE_KEY=

# Outgoing email (verification / password reset) via Mailtrap or any SMTP
# provider. Get these from https://mailtrap.io (or your provider of choice)
# for local development.
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
